# Copy to .env and fill in only what your own model wrapper needs.
# faithgap itself requires NO keys — the quickstart runs fully offline on MockModel.
# These are only for the examples/openai_template.py style wrappers you write yourself.

OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
